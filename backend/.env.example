# Database Connection (Option A: Discrete Variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=smart_event_booking
# Set DB_SSL=true if using hosted cloud MySQL (Aiven, Railway, AWS RDS, etc.)
DB_SSL=false

# Database Connection (Option B: Single Cloud URI)
# DATABASE_URL=mysql://user:password@host:port/dbname

# Server Configuration
PORT=5002
NODE_ENV=production

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Allowed Frontend URL for CORS (e.g. your Vercel URL)
FRONTEND_URL=https://your-evently-app.vercel.app
