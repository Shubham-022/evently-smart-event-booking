# Backend API Base URL (must point to your Render backend with /api)
# Production Example: https://evently-api.onrender.com/api
VITE_API_URL=http://localhost:5002/api

# Backend Base URL for Socket.IO (without /api)
# Production Example: https://evently-api.onrender.com
VITE_BACKEND_URL=http://localhost:5002

# Optional Google Maps API Key (built-in interactive fallback will display if omitted)
VITE_GOOGLE_MAPS_API_KEY=
